# zmk-driver-pim447/Kconfig

menuconfig PIM447
    bool "Pimoroni PIM447 trackball driver"
    depends on I2C
    depends on INPUT
    help
      Enable the Pimoroni PIM447 Trackball Breakout driver.

      Supports both interrupt-driven (preferred, requires int-gpios in
      devicetree) and polling fallback modes.

if PIM447

module = PIM447
module-str = pim447
source "subsys/logging/Kconfig.template.log_config"

endif # PIM447
